{
  "name": "@mintopia/cc-acp",
  "version": "0.2.0",
  "description": "ACP agent for Claude Code that drives an interactive session in tmux",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mintopia/cc-acp-mod.git"
  },
  "type": "module",
  "bin": {
    "cc-acp": "dist/index.js"
  },
  "files": [
    "dist",
    "mod"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "e2e": "npm run build && node e2e/run.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
